# Agent Dashboard - Environment Variables Example
# Copy this file to .env.local and configure your values

# ============================================
# API Configuration
# ============================================
# Backend API base URL (e.g., http://localhost:8080)
VITE_API_BASE_URL=http://localhost:8080

# ============================================
# WebSocket Configuration
# ============================================
# WebSocket server URL (e.g., ws://localhost:8080/ws or http://localhost:8080/ws for SockJS)
VITE_WS_BASE_URL=http://localhost:8080/ws

# ============================================
# Application Settings
# ============================================
# Application title
VITE_APP_TITLE=Agent Dashboard

# Application version
VITE_APP_VERSION=1.0.0

# ============================================
# Feature Flags
# ============================================
# Enable 3D scene visualization (true/false)
VITE_ENABLE_3D_SCENE=true

# Enable debug mode (true/false)
VITE_DEBUG_MODE=false

# Enable agent auto-refresh interval in milliseconds (0 = disabled)
VITE_AUTO_REFRESH_INTERVAL=5000

# ============================================
# WebSocket Settings
# ============================================
# WebSocket reconnection delay in milliseconds
VITE_WS_RECONNECT_DELAY=3000

# Maximum WebSocket reconnection attempts
VITE_WS_MAX_RECONNECT_ATTEMPTS=5

# WebSocket heartbeat interval in milliseconds
VITE_WS_HEARTBEAT_INTERVAL=4000

# ============================================
# Development Settings
# ============================================
# Mock data for development (true/false)
VITE_USE_MOCK_DATA=false

# Mock agents count for development
VITE_MOCK_AGENTS_COUNT=4
